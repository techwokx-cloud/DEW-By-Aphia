# ── AI Stylist agent (app/api/ai/stylist, and the marketing/DM/newsletter agents) ──
# Free tier via Groq (console.groq.com), no credit card required.
# Get a key at https://console.groq.com/keys
# Without this set, all agents fall back to rule-based logic so the demo
# still works end-to-end — just less smart.
GROQ_API_KEY=placeholder_get_your_key_at_console.groq.com

# ── Admin dashboard password (/admin) ──
# Falls back to "dew-admin-2026" if unset — change this before going live.
ADMIN_PASSWORD=placeholder_choose_your_own_password

# ── Instagram Graph API (posting + DMs from the admin dashboard) ──
# Requires: Meta Developer App, Instagram Business Account linked to a
# Facebook Page, and Meta app review for the relevant permissions.
# Until these are set, approved content/DMs stay queued instead of sending.
IG_ACCESS_TOKEN=placeholder_from_meta_developer_console
IG_BUSINESS_ACCOUNT_ID=placeholder_instagram_business_account_id

# ── WhatsApp Business Platform (owner approval notifications) ──
# Separate from your customer-facing wa.me ordering number — this is the
# Cloud API used to *send* you a WhatsApp message when content needs review.
WHATSAPP_BUSINESS_TOKEN=placeholder_from_meta_developer_console
WHATSAPP_PHONE_NUMBER_ID=placeholder_meta_assigned_phone_id
WHATSAPP_OWNER_NUMBER=placeholder_233XXXXXXXXX_no_plus_sign

# ── Reel video generation ──
# json2video (json2video.com, free tier) assembles the actual MP4 from the
# AI-written script + images. fal.ai (fal.ai/dashboard/keys, free trial
# credit) generates an AI background image when no uploaded photo is
# available. Both optional — without them, Reels still generates a full
# script for you to film yourself.
JSON2VIDEO_API_KEY=placeholder_from_json2video.com
FAL_KEY=placeholder_from_fal.ai_dashboard

# ── Phase 2: Supabase project (not yet wired — Phase 1 uses lib/products-data.ts) ──
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
